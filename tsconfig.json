{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["src/*"],
      "@data/*": ["data/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "data/**/*"],
  "exclude": ["dist", "node_modules", "Temp"]
}
