---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EeatVerifyBar from '../../components/EeatVerifyBar.astro';
import { getAllNews } from '../../lib/news';

const allNews = getAllNews();

const newsHubSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Photovoltaik Aktuelles & Markt-Ticker November 2026 — SOLARMETRIK',
    description:
      'Aktuelle Meldungen, Bundesnetzagentur-Zubauzahlen, EEG-2027-Gesetzgebung, Solarspitzengesetz-Praxis und Modul-/Speicherpreise im November 2026.',
    url: 'https://solarmetrik.de/aktuelles',
    publisher: {
      '@type': 'Organization',
      name: 'SOLARMETRIK Deutschland',
      url: 'https://solarmetrik.de'
    },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: allNews.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://solarmetrik.de/aktuelles/${item.slug}`,
        name: item.title
      }))
    }
  }
];
---

<BaseLayout
  title="Photovoltaik Aktuelles November 2026: EEG, Preise & Zubau"
  description="Aktuelle Photovoltaik-Nachrichten im November 2026: Bundesnetzagentur 130-GW-Bilanz, EEG-2027-Countdown (31.12.2026), Solarspitzengesetz & Speicherpreise Q4."
  canonicalPath="/aktuelles"
  activeSection="aktuelles"
  schema={newsHubSchema}
>
  <section class="ax-section" style="padding-top: 44px;">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Startseite', href: '/' },
          { label: 'Aktuelles & Photovoltaik-Marktticker (November 2026)' }
        ]}
      />

      <div style="max-width: 820px; margin-bottom: 32px;">
        <span class="ax-eyebrow">SOLARMETRIK Markt- & Regulierungs-Ticker · Stand November 2026</span>
        <h1 class="ax-h1">PHOTOVOLTAIK AKTUELLES: MARKT, PREISE & EEG-REGULIERUNG (11/2026)</h1>
        <p class="ax-sub">
          Verifizierte Kurzmeldungen und Datenanalysen zu Bundesnetzagentur-Zubauzahlen,
          Smart-Meter-Rollout (§ 9 EEG), zeitvariablen Netzentgelten (§ 14a EnWG) und dem
          Quartals-Preisindex für N-Type-Module und LFP-Heimspeicher.
        </p>
      </div>

      <EeatVerifyBar updatedDate="11. November 2026" />

      <div class="ax-cards-3" style="margin-top: 40px;">
        {allNews.map((item, idx) => (
          <a href={`/aktuelles/${item.slug}`} class="ax-photo-card">
            <div class="ax-photo-card__img-wrap">
              <img
                src={item.heroImage}
                alt={item.heroAlt}
                width="800"
                height="600"
                loading={idx < 3 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="ax-photo-card__meta">
              {item.displayDate} · {item.category}
            </div>
            <div class="ax-photo-card__title">{item.title}</div>
            <p class="ax-photo-card__desc">
              {item.summary.slice(0, 165)}…
            </p>
            <span class="ax-photo-card__caption">Vollständige Meldung & Datenanalyse lesen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
