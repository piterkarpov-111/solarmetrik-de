    <script is:inline>
      (function () {
        const stateSel = document.getElementById('us-state-select');
        const billRange = document.getElementById('us-bill-range');
        const kwRange = document.getElementById('us-system-kw');
        const batCheck = document.getElementById('us-include-battery');

        const btnAll = document.getElementById('btn-region-all');
        const btnUs = document.getElementById('btn-region-us');
        const btnEu = document.getElementById('btn-region-eu');
        const optgroupUs = document.getElementById('optgroup-us');
        const optgroupEu = document.getElementById('optgroup-eu');

        const billDisp = document.getElementById('us-bill-display');
        const kwDisp = document.getElementById('us-kw-display');
        const incText = document.getElementById('us-state-incentive-text');

        const resGross = document.getElementById('res-gross-cost');
        const resItcLabel = document.getElementById('res-itc-label');
        const resItc = document.getElementById('res-itc-credit');
        const resNet = document.getElementById('res-net-cost');
        const resKwh = document.getElementById('res-annual-kwh');
        const resYr1 = document.getElementById('res-yr1-savings');
        const res25Yr = document.getElementById('res-25yr-savings');

        function fmtCur(n, cur) {
          return cur + Math.round(n).toLocaleString('en-US');
        }

        function setRegionFilter(mode) {
          [btnAll, btnUs, btnEu].forEach(function (b) {
            if (b) b.classList.remove('active');
          });
          if (mode === 'US' && btnUs) {
            btnUs.classList.add('active');
            if (optgroupUs) optgroupUs.disabled = false;
            if (optgroupEu) optgroupEu.disabled = true;
            if (stateSel.options[stateSel.selectedIndex].getAttribute('data-region') !== 'US') {
              stateSel.value = 'US-FL';
            }
          } else if (mode === 'EU' && btnEu) {
            btnEu.classList.add('active');
            if (optgroupUs) optgroupUs.disabled = true;
            if (optgroupEu) optgroupEu.disabled = false;
            if (stateSel.options[stateSel.selectedIndex].getAttribute('data-region') !== 'EU') {
              stateSel.value = 'EU-DE';
            }
          } else if (btnAll) {
            btnAll.classList.add('active');
            if (optgroupUs) optgroupUs.disabled = false;
            if (optgroupEu) optgroupEu.disabled = false;
          }
          recalc();
        }

        if (btnAll) btnAll.addEventListener('click', function () { setRegionFilter('ALL'); });
        if (btnUs) btnUs.addEventListener('click', function () { setRegionFilter('US'); });
        if (btnEu) btnEu.addEventListener('click', function () { setRegionFilter('EU'); });

        function recalc() {
          if (!stateSel || !billRange || !kwRange || !batCheck) return;
          const opt = stateSel.options[stateSel.selectedIndex];
          const cur = opt.getAttribute('data-currency') || '$';
          const region = opt.getAttribute('data-region') || 'US';
          const yieldPerKw = parseFloat(opt.getAttribute('data-yield') || '1590');
          const rate = parseFloat(opt.getAttribute('data-rate') || '0.16');
          const costPerWatt = parseFloat(opt.getAttribute('data-cost') || '2.58');
          const batCostBase = parseFloat(opt.getAttribute('data-batcost') || '8200');
          const subPct = parseFloat(opt.getAttribute('data-subpct') || '30');
          const subLabel = opt.getAttribute('data-sublabel') || '30% Federal Tax Credit (§ 25D)';
          const incentive = opt.getAttribute('data-incentive') || '';

          const bill = parseFloat(billRange.value || '240');
          const kw = parseFloat(kwRange.value || '10');
          const hasBat = batCheck.checked;

          const panels = Math.round((kw * 1000) / 425);
          billDisp.textContent = cur + bill + ' / month';
          kwDisp.textContent = kw.toFixed(1) + (region === 'EU' ? ' kWp (' : ' kW (') + panels + ' Panels)';
          incText.textContent = incentive;
          if (resItcLabel) resItcLabel.textContent = subLabel;

          let gross = 0;
          let savingAmt = 0;
          let net = 0;

          if (region === 'US') {
            const pvCost = kw * 1000 * costPerWatt;
            const batCost = hasBat ? batCostBase : 0;
            gross = pvCost + batCost;
            savingAmt = gross * (subPct / 100);
            net = gross - savingAmt;
          } else {
            // In EU, costPerWatt is already net 0% VAT turnkey; gross includes the waived VAT/tax benefit
            const pvNet = kw * 1000 * costPerWatt;
            const batNet = hasBat ? batCostBase : 0;
            net = pvNet + batNet;
            savingAmt = net * (subPct / 100);
            gross = net + savingAmt;
          }

          const annualKwh = Math.round(kw * yieldPerKw);
          const selfUseRatio = hasBat ? 0.84 : 0.62;
          const feedInPrice = region === 'EU' ? 0.08 : 0.05;
          const selfSaved = Math.min(bill * 12 * 0.94, annualKwh * selfUseRatio * rate);
          const exportRev = annualKwh * (1 - selfUseRatio) * feedInPrice;
          const yr1Savings = selfSaved + exportRev;

          let total25 = 0;
          for (let y = 0; y < 25; y++) {
            total25 += yr1Savings * Math.pow(1.03, y) * Math.pow(0.995, y);
          }
          const netProfit25 = Math.max(9500, total25 - net);

          resGross.textContent = fmtCur(gross, cur);
          resItc.textContent = '-' + fmtCur(savingAmt, cur);
          resNet.textContent = fmtCur(net, cur);
          resKwh.textContent = annualKwh.toLocaleString('en-US') + ' kWh/yr';
          resYr1.textContent = fmtCur(yr1Savings, cur) + ' / yr';
          res25Yr.textContent = '+' + fmtCur(netProfit25, cur);
        }

        [stateSel, billRange, kwRange, batCheck].forEach(function (el) {
          if (el) el.addEventListener('input', recalc);
          if (el) el.addEventListener('change', recalc);
        });
        recalc();
      })();
    </script>

