---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href="https://solarmetrik.de" />
    <link rel="alternate" hreflang="en" href="https://solarmetrik.de/en" />
    <link rel="alternate" hreflang="x-default" href="https://solarmetrik.de" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="SOLARMETRIK International" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://solarmetrik.de/images/hero-solaranlage-deutschland-2026.webp" />

    {enSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <style>
      .en-table-card {
        background: #ffffff;
        border: 1px solid var(--border-hairline);
        border-radius: 10px;
        overflow-x: auto;
        box-shadow: 0 4px 18px rgba(15, 76, 129, 0.03);
      }
      .en-data-table {
        width: 100%;
        min-width: 780px;
        border-collapse: collapse;
        text-align: left;
        font-size: 14px;
      }
      .en-data-table thead th {
        background: #f6f7f9;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 15px 18px;
        border-bottom: 1.5px solid var(--text-primary);
        white-space: nowrap;
      }
      .en-data-table tbody td {
        padding: 15px 18px;
        border-bottom: 1px solid var(--border-hairline);
        color: var(--text-secondary);
        vertical-align: middle;
        line-height: 1.45;
      }
      .en-data-table tbody tr:last-child td {
        border-bottom: none;
      }
      .en-data-table tbody tr:hover {
        background: #fafbfc;
      }
      .en-score-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 5px;
        background: var(--accent-blue-light);
        color: var(--accent-blue);
        font-family: var(--font-condensed);
        font-weight: 700;
        font-size: 15px;
      }
      @media (max-width: 960px) {
        .en-hero-grid {
          grid-template-columns: 1fr !important;
          gap: 32px !important;
        }
      }
    </style>
  </head>
  <body>
    <!-- AXOPAR INTERNATIONAL HEADER -->
    <header class="ax-header" id="ax-site-header">
      <div class="ax-header__utility">
        <span>Data Sources: US NREL PVWatts® v8 · EU PVGIS · DWD (Updated: 11/2026)</span>
        <a href="#us-calculator">US & EU Calculator →</a>
        <a href="#state-atlas">US & EU Solar Atlas →</a>
        <a href="/">🇩🇪 Deutsche Version (DE) →</a>
      </div>

      <div class="ax-header__main">
        <a href="/en" class="ax-logo" aria-label="SOLARMETRIK International Home">
          SOLARMETRIK<span class="ax-logo__fin"></span>
        </a>

        <nav class="ax-nav ax-nav--desktop" aria-label="Main Navigation">
          <div class="ax-nav__item">
            <a href="#us-calculator" class="ax-nav__link active">US & EU Solar Calculator</a>
          </div>
          <div class="ax-nav__item">
            <a href="#state-atlas" class="ax-nav__link">US State Atlas (NREL)</a>
          </div>
          <div class="ax-nav__item">
            <a href="#eu-atlas" class="ax-nav__link">EU Country Atlas (PVGIS)</a>
          </div>
          <div class="ax-nav__item">
            <a href="#cost-benchmarks" class="ax-nav__link">2026 Price Matrix</a>
          </div>
          <div class="ax-nav__item">
            <a href="/" class="ax-nav__link">DE Portal</a>
          </div>
        </nav>

        <div class="ax-header__cta">
          <a href="#us-calculator" class="ax-btn ax-btn--primary" style="padding: 10px 18px; font-size: 13.5px;">
            Launch Solar Calculator →
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO SECTION -->
      <section class="ax-section" style="padding-top: 56px; padding-bottom: 56px; background: var(--bg-soft); border-bottom: 1px solid var(--border-hairline);">
        <div class="container">
          <div class="en-hero-grid" style="display: grid; grid-template-columns: 1.25fr 0.95fr; gap: 48px; align-items: center;">
            <div>
              <span class="ax-eyebrow">SOLARMETRIK International · US NREL PVWatts® & European PVGIS Telemetry (11/2026)</span>
              <h1 class="ax-h1" style="margin-bottom: 20px;">
                INDEPENDENT SOLAR ROI, BATTERY SIZING & TAX CREDIT ENGINE FOR US & EU HOMEOWNERS
              </h1>
              <p class="ax-sub" style="margin-bottom: 28px;">
                Precision photovoltaic telemetry and 25-year financial modeling based on US NREL National Solar Radiation Database (NSRDB) and European PVGIS / DWD records. Calculate your exact rooftop yield, whole-home LFP battery backup autonomy, <strong>US 30% Federal Tax Credit (IRS § 25D)</strong>, and <strong>European 0% VAT / Feed-In Incentives</strong>.
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 14px;">
                <a href="#us-calculator" class="ax-btn ax-btn--primary">
                  Launch US & EU Solar Calculator →
                </a>
                <a href="#state-atlas" class="ax-btn ax-btn--light">
                  Compare US & EU Solar Benchmarks ↓
                </a>
              </div>

              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-hairline);">
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--accent-blue);">30% US / 0% VAT EU</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">US IRS § 25D Tax Credit & EU 0% VAT Exemption (DE, AT, NL, UK)</div>
                </div>
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--accent-green);">5.4 – 8.5 YRS</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Verified Residential Turnkey Payback Window Across US & EU</div>
                </div>
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--text-primary);">NREL + PVGIS</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Satellite Irradiance & Time-of-Use Battery Storage Modeling</div>
                </div>
              </div>
            </div>

            <div>
              <img
                src="/images/hero-solaranlage-deutschland-2026.webp"
                alt="Residential rooftop solar panels and whole-home battery storage system"
                style="width: 100%; border-radius: var(--radius-photo); object-fit: cover; aspect-ratio: 4/3; box-shadow: 0 18px 40px rgba(15, 76, 129, 0.08);"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- INTERACTIVE US & EU SOLAR CALCULATOR -->
      <section class="ax-section" id="us-calculator">
        <div class="container">
          <div style="max-width: 820px; margin-bottom: 36px;">
            <span class="ax-eyebrow">Interactive Engineering Tool · US NREL PVWatts® (IRS § 25D) & EU PVGIS (0% VAT / EEG)</span>
            <h2 class="ax-h2">US & EUROPEAN RESIDENTIAL SOLAR YIELD, BATTERY BACKUP & INCENTIVE CALCULATOR</h2>
            <p class="ax-sub">
              Switch between <strong>United States ($ USD)</strong> and <strong>Europe (€ EUR / £ GBP)</strong> markets below to simulate your recommended solar array size, LFP battery storage, tax credit/VAT exemption, and 25-year net return.
            </p>
          </div>

          <div class="calc-grid-light">
            <!-- Calculator Inputs -->
            <div class="calc-card-light" style="display: flex; flex-direction: column; gap: 22px;">
              <div>
                <div style="font-weight: 600; font-size: 14px; margin-bottom: 8px;">
                  1. Quick Region Filter
                </div>
                <div class="preset-row" style="margin-bottom: 0;">
                  <button type="button" class="preset-chip active" id="btn-region-all">All Markets (US + EU)</button>
                  <button type="button" class="preset-chip" id="btn-region-us">🇺🇸 United States ($)</button>
                  <button type="button" class="preset-chip" id="btn-region-eu">🇪🇺 Europe (€ / £)</button>
                </div>
              </div>

              <div>
                <label for="us-state-select" style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 8px;">
                  2. Select US State or European Country (NREL / PVGIS Irradiance Profile)
                </label>
                <select
                  id="us-state-select"
                  class="form-select"
                >
                  <optgroup label="🇺🇸 United States Markets (NREL PVWatts® · 30% Federal ITC)" id="optgroup-us">
                    {usStatesData.map((s, idx) => (
                      <option
                        value={s.code}
                        data-region={s.region}
                        data-currency={s.currency}
                        data-yield={s.yieldKwhKw}
                        data-rate={s.elecRate}
                        data-cost={s.costPerWatt}
                        data-batcost={s.batCost}
                        data-subpct={s.subsidyPct}
                        data-sublabel={s.subsidyLabel}
                        data-incentive={s.stateIncentive}
                        selected={idx === 1}
                      >
                        {s.name} — {s.yieldKwhKw} kWh/kW/yr ({s.currency}{s.elecRate.toFixed(2)}/kWh)
                      </option>
                    ))}
                  </optgroup>
                  <optgroup label="🇪🇺 European Markets (EU PVGIS / DWD · 0% VAT & Feed-In)" id="optgroup-eu">
                    {euCountriesData.map((s) => (
                      <option
                        value={s.code}
                        data-region={s.region}
                        data-currency={s.currency}
                        data-yield={s.yieldKwhKw}
                        data-rate={s.elecRate}
                        data-cost={s.costPerWatt}
                        data-batcost={s.batCost}
                        data-subpct={s.subsidyPct}
                        data-sublabel={s.subsidyLabel}
                        data-incentive={s.stateIncentive}
                      >
                        {s.name} — {s.yieldKwhKw} kWh/kWp/yr ({s.currency}{s.elecRate.toFixed(2)}/kWh)
                      </option>
                    ))}
                  </optgroup>
                </select>
              </div>

              <div>
                <div class="slider-header">
                  <label for="us-bill-range" style="font-weight: 600;">
                    3. Average Monthly Electric Bill
                  </label>
                  <strong id="us-bill-display" style="color: var(--accent-blue); font-size: 16px;">$240 / month</strong>
                </div>
                <input
                  type="range"
                  id="us-bill-range"
                  class="slider-input"
                  min="90"
                  max="650"
                  step="10"
                  value="240"
                />
                <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                  <span>90/mo (Compact Home)</span>
                  <span>240/mo (Family Home)</span>
                  <span>650/mo (Large Home + EV/Heat Pump)</span>
                </div>
              </div>

              <div>
                <div class="slider-header">
                  <label for="us-system-kw" style="font-weight: 600;">
                    4. Target Solar Array Size (kW / kWp)
                  </label>
                  <strong id="us-kw-display" style="color: var(--accent-blue); font-size: 16px;">10.0 kW (24 Panels)</strong>
                </div>
