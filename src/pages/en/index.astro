---
import '../../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

const siteUrl = 'https://solarmetrik.de';
const canonicalUrl = `${siteUrl}/en`;
const title = 'SOLARMETRIK International — US & EU Solar Yield, Battery Sizing & 30% Tax Credit Calculator (2026)';
const description =
  'Independent engineering portal & solar ROI calculator for US and European homeowners. Calculate 2026 NREL/PVGIS solar generation, LFP battery sizing, and 30% Federal Residential Clean Energy Credit (§ 25D ITC).';

const usStatesData = [
  {
    code: 'CA',
    name: 'California (NEM 3.0 / SGIP)',
    cities: 'San Diego, Los Angeles, Sacramento, San Jose, Fresno',
    yieldKwhKw: 1680,
