    stateIncentive: 'SGIP Battery Storage Rebate ($150–$1,000/kWh) + 30% Federal ITC (§ 25D)',
    recommendedBatteryKwh: 13.5,
    smeScore: 96
  },
  {
    code: 'FL',
    name: 'Florida (Net Metering + Property Tax Exemption)',
    cities: 'Orlando, Miami, Tampa, Gainesville, Jacksonville',
    yieldKwhKw: 1590,
    elecRateUsd: 0.16,
    costPerWattUsd: 2.58,
    itcPercent: 30,
    stateIncentive: '100% Solar Sales Tax & Property Tax Exemption + Full 1:1 Retail Net Metering + 30% ITC',
    recommendedBatteryKwh: 10.0,
    smeScore: 93
  },
  {
    code: 'AZ',
    name: 'Arizona (APS / SRP Export Rate)',
    cities: 'Phoenix, Mesa, Tucson, Scottsdale, Chandler',
    yieldKwhKw: 1820,
    elecRateUsd: 0.15,
    costPerWattUsd: 2.48,
    itcPercent: 30,
    stateIncentive: '$1,000 Arizona State Solar Tax Credit (25%) + 100% Sales/Property Tax Exemption + 30% ITC',
    recommendedBatteryKwh: 10.0,
    smeScore: 95
  },
  {
    code: 'TX',
    name: 'Texas (ERCOT Solar Buyback & Backup)',
    cities: 'Austin, Houston, Dallas, San Antonio, Fort Worth',
    yieldKwhKw: 1610,
    elecRateUsd: 0.16,
    costPerWattUsd: 2.52,
    itcPercent: 30,
    stateIncentive: 'Austin Energy ($2,500 Rebate) / Oncor Solar & Battery Incentives + 100% Property Tax Exemption + 30% ITC',
    recommendedBatteryKwh: 15.0,
    smeScore: 92
  },
  {
    code: 'LA',
    name: 'Louisiana (Whole-Home Hurricane Resilience & Net Billing)',
    cities: 'New Orleans, Baton Rouge, Metairie, Lafayette',
    yieldKwhKw: 1520,
    elecRateUsd: 0.14,
    costPerWattUsd: 2.62,
    itcPercent: 30,
    stateIncentive: '30% Federal Residential Clean Energy Credit (§ 25D) on Rooftop PV + Whole-Home LFP Battery Backup',
    recommendedBatteryKwh: 15.0,
    smeScore: 89
  },
  {
    code: 'NY',
    name: 'New York (NY-Sun Megawatt Block + State Credit)',
    cities: 'New York City, Long Island, Albany, Buffalo',
    yieldKwhKw: 1310,
    elecRateUsd: 0.25,
    costPerWattUsd: 2.95,
    itcPercent: 30,
    stateIncentive: '$5,000 NY State Income Tax Credit (25%) + NY-Sun Upfront Rebate + 30% Federal ITC',
    recommendedBatteryKwh: 10.0,
    smeScore: 91
  },
  {
    code: 'MA',
    name: 'Massachusetts (SMART Program & Mass Save)',
    cities: 'Boston, Cambridge, Worcester, Springfield',
    yieldKwhKw: 1340,
    elecRateUsd: 0.29,
    costPerWattUsd: 2.98,
    itcPercent: 30,
    stateIncentive: '$1,000 State Credit + ConnectedSolutions Battery Payouts ($275/kW/yr) + 30% Federal ITC',
    recommendedBatteryKwh: 13.5,
    smeScore: 92
  },
  {
    code: 'CO',
    name: 'Colorado (Xcel Energy Solar*Rewards)',
    cities: 'Denver, Colorado Springs, Boulder, Fort Collins',
    yieldKwhKw: 1690,
    elecRateUsd: 0.17,
    costPerWattUsd: 2.68,
    itcPercent: 30,
    stateIncentive: 'Xcel Energy Battery Connect Rebate + 100% Sales/Property Tax Exemption + 30% Federal ITC',
    recommendedBatteryKwh: 10.0,
    smeScore: 91
  }
];

const usCostTable = [
  {
    size: '6 kW System',
    panels: '14–15 Panels (~260 sq.ft.)',
    grossUsd: '$15,600',
    itcCredit: '-$4,680',
    netUsd: '$10,920',
    annualYield: '9,100 – 10,800 kWh',
    savings25Yr: '$38,400+'
  },
  {
    size: '8 kW System',
    panels: '19–20 Panels (~350 sq.ft.)',
    grossUsd: '$20,400',
    itcCredit: '-$6,120',
    netUsd: '$14,280',
    annualYield: '12,200 – 14,500 kWh',
    savings25Yr: '$51,200+'
  },
  {
    size: '10 kW (US Benchmark)',
    panels: '24–25 Panels (~440 sq.ft.)',
    grossUsd: '$25,200',
    itcCredit: '-$7,560',
    netUsd: '$17,640',
    annualYield: '15,200 – 18,200 kWh',
    savings25Yr: '$64,800+'
  },
  {
    size: '10 kW + 13.5 kWh LFP Battery',
    panels: '24–25 Panels + Whole-Home Backup',
    grossUsd: '$34,800',
    itcCredit: '-$10,440',
    netUsd: '$24,360',
    annualYield: '15,200 – 18,200 kWh (92% Self-Powered)',
    savings25Yr: '$76,500+'
  },
  {
    size: '12 kW + 15 kWh LFP Battery',
    panels: '28–30 Panels + EV & HVAC Backup',
    grossUsd: '$39,900',
    itcCredit: '-$11,970',
    netUsd: '$27,930',
    annualYield: '18,500 – 21,800 kWh',
    savings25Yr: '$91,000+'
  },
  {
    size: '15 kW Estate + 20 kWh Storage',
    panels: '36–38 Panels (~660 sq.ft.)',
    grossUsd: '$48,500',
    itcCredit: '-$14,550',
    netUsd: '$33,950',
    annualYield: '23,000 – 27,300 kWh',
    savings25Yr: '$114,000+'
  }
];

const enSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonicalUrl}/#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: {
      '@type': 'WebSite',
      name: 'SOLARMETRIK',
      url: siteUrl
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SOLARMETRIK US & EU Solar ROI & 30% Federal Tax Credit Calculator (2026)',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD'
    },
    description:
      'Interactive solar payback, NREL irradiance, whole-home battery sizing, and 30% Federal Investment Tax Credit (§ 25D) calculator for US and European homeowners.'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href="https://solarmetrik.de" />
    <link rel="alternate" hreflang="en" href="https://solarmetrik.de/en" />
    <link rel="alternate" hreflang="x-default" href="https://solarmetrik.de" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
    />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="SOLARMETRIK International" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://solarmetrik.de/images/hero-solaranlage-deutschland-2026.webp" />

    {enSchema.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <!-- AXOPAR INTERNATIONAL HEADER -->
    <header class="ax-header" id="ax-site-header">
      <div class="ax-header__utility">
        <span>Data Sources: NREL PVWatts® v8 · US DOE · PVGIS · DWD (Updated: 11/2026)</span>
        <a href="#us-calculator">US 30% Tax Credit Calculator →</a>
        <a href="#battery-comparison">Whole-Home Battery Benchmarks →</a>
        <a href="/">🇩🇪 Deutsche Version (DE) →</a>
      </div>

      <div class="ax-header__main">
        <a href="/en" class="ax-logo" aria-label="SOLARMETRIK International Home">
          SOLARMETRIK<span class="ax-logo__fin"></span>
        </a>

        <nav class="ax-nav ax-nav--desktop" aria-label="Main Navigation">
          <div class="ax-nav__item">
            <a href="#us-calculator" class="ax-nav__link active">US Solar & ITC Calculator</a>
          </div>
          <div class="ax-nav__item">
            <a href="#state-atlas" class="ax-nav__link">US State Atlas (NREL)</a>
          </div>
          <div class="ax-nav__item">
            <a href="#cost-benchmarks" class="ax-nav__link">2026 Price Benchmarks</a>
          </div>
          <div class="ax-nav__item">
            <a href="#battery-comparison" class="ax-nav__link">LFP Storage & Backup</a>
          </div>
          <div class="ax-nav__item">
            <a href="/" class="ax-nav__link">DE / DACH Portal</a>
          </div>
        </nav>

        <div class="ax-header__cta">
          <a href="#us-calculator" class="ax-btn ax-btn--dark ax-btn--sm">
            Calculate 30% Tax Credit →
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO SECTION -->
      <section class="ax-section" style="padding-top: 56px; padding-bottom: 56px; background: var(--bg-soft); border-bottom: 1px solid var(--border-hairline);">
        <div class="container">
          <div style="display: grid; grid-template-columns: 1.25fr 0.95fr; gap: 48px; align-items: center;">
            <div>
              <span class="ax-eyebrow">SOLARMETRIK International · NREL PVWatts® & IRS § 25D Reference Data (11/2026)</span>
              <h1 class="ax-h1" style="margin-bottom: 20px;">
                INDEPENDENT SOLAR ROI, BATTERY SIZING & 30% TAX CREDIT ENGINE FOR US & EU HOMEOWNERS
              </h1>
              <p class="ax-sub" style="margin-bottom: 28px;">
                Precision photovoltaic telemetry and 25-year financial modeling based on NREL National Solar Radiation Database (NSRDB) and European PVGIS records. Calculate your exact rooftop yield, whole-home LFP battery backup autonomy, and 30% Federal Residential Clean Energy Credit (§ 25D).
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 14px;">
                <a href="#us-calculator" class="ax-btn ax-btn--dark">
                  Launch US Solar & 30% ITC Calculator →
                </a>
                <a href="#state-atlas" class="ax-btn ax-btn--outline-dark">
                  View US State Solar Benchmarks
                </a>
              </div>

              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-hairline);">
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--accent-blue);">30% UNCAPPED</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Federal Tax Credit (IRS § 25D) for PV + Battery Storage ≥ 3 kWh</div>
                </div>
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--accent-green);">5.4 – 7.8 YRS</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Average US Residential Payback Window (CA, FL, AZ, TX, NY)</div>
                </div>
                <div>
                  <div style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--text-primary);">NREL + PVGIS</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Verified TMY3 Satellite Irradiance & Utility Tariff Modeling</div>
                </div>
              </div>
            </div>

            <div>
              <img
                src="/images/hero-solaranlage-deutschland-2026.webp"
                alt="Residential rooftop solar panels and whole-home battery storage system"
                style="width: 100%; border-radius: var(--radius-photo); object-fit: cover; aspect-ratio: 4/3; box-shadow: 0 18px 40px rgba(15, 76, 129, 0.08);"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- INTERACTIVE US SOLAR & 30% ITC CALCULATOR -->
      <section class="ax-section" id="us-calculator">
        <div class="container">
          <div style="max-width: 820px; margin-bottom: 36px;">
            <span class="ax-eyebrow">Interactive Engineering Tool · IRS Form 5695 (§ 25D) & NREL PVWatts®</span>
            <h2 class="ax-h2">US RESIDENTIAL SOLAR YIELD, BATTERY BACKUP & 30% TAX CREDIT CALCULATOR</h2>
            <p class="ax-sub">
              Select your state, monthly electric bill, and roof orientation to simulate your recommended system size (kW), Federal 30% Tax Credit deduction, and 25-year cumulative utility savings.
            </p>
          </div>

          <div style="display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 36px; align-items: start; background: var(--bg-soft); padding: 36px; border-radius: var(--radius-photo); border: 1px solid var(--border-hairline);">
            <!-- Calculator Inputs -->
            <div style="display: flex; flex-direction: column; gap: 22px;">
              <div>
                <label for="us-state-select" style="display: block; font-weight: 600; font-size: 14px; margin-bottom: 8px;">
                  1. Select US State / Utility Region (NREL Irradiance Profile)
                </label>
                <select
                  id="us-state-select"
                  style="width: 100%; padding: 12px 14px; border-radius: 6px; border: 1px solid var(--border-button); background: #fff; font-size: 15px;"
                >
                  {usStatesData.map((s, idx) => (
                    <option
                      value={s.code}
                      data-yield={s.yieldKwhKw}
                      data-rate={s.elecRateUsd}
                      data-cost={s.costPerWattUsd}
                      data-incentive={s.stateIncentive}
                      data-battery={s.recommendedBatteryKwh}
                      selected={idx === 1}
                    >
                      {s.name} — {s.yieldKwhKw} kWh/kW/yr (${s.elecRateUsd.toFixed(2)}/kWh avg)
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                  <label for="us-bill-range" style="font-weight: 600; font-size: 14px;">
                    2. Average Monthly Electric Bill ($ USD)
                  </label>
                  <strong id="us-bill-display" style="color: var(--accent-blue); font-size: 16px;">$240 / month</strong>
                </div>
                <input
                  type="range"
                  id="us-bill-range"
                  min="90"
                  max="650"
                  step="10"
                  value="240"
                  style="width: 100%; accent-color: var(--accent-blue);"
                />
                <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-top: 4px;">
                  <span>$90/mo (Small Home)</span>
                  <span>$250/mo (Average Family)</span>
                  <span>$650/mo (Large Home + Pool/EV)</span>
                </div>
              </div>

              <div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                  <label for="us-system-kw" style="font-weight: 600; font-size: 14px;">
                    3. Target Solar Array Size (kW DC)
                  </label>
                  <strong id="us-kw-display" style="color: var(--accent-blue); font-size: 16px;">10.0 kW (24 Panels)</strong>
                </div>
                <input
                  type="range"
                  id="us-system-kw"
                  min="5"
                  max="20"
                  step="1"
                  value="10"
                  style="width: 100%; accent-color: var(--accent-blue);"
                />
              </div>

              <div>
                <label style="display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; cursor: pointer;">
                  <input type="checkbox" id="us-include-battery" checked style="width: 18px; height: 18px; accent-color: var(--accent-blue);" />
                  <span>Include 13.5 kWh LFP Whole-Home Battery Backup (Qualifies for 30% Federal ITC)</span>
                </label>
              </div>

              <div style="padding: 16px; background: #ffffff; border-radius: 8px; border: 1px solid var(--border-hairline);">
                <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600; margin-bottom: 4px;">
                  Active Regional & Federal Incentives (11/2026):
                </div>
                <div id="us-state-incentive-text" style="font-size: 14px; font-weight: 500; color: var(--text-primary);">
                  100% Solar Sales Tax & Property Tax Exemption + Full 1:1 Retail Net Metering + 30% ITC
                </div>
              </div>
            </div>

            <!-- Calculator Results Card -->
            <div style="background: #ffffff; padding: 32px; border-radius: var(--radius-photo); border: 1px solid var(--border-hairline);">
              <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-blue); font-weight: 700; margin-bottom: 10px;">
                SOLARMETRIK Engineering Simulation Result
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding-bottom: 20px; border-bottom: 1px solid var(--border-hairline);">
                <div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Estimated Turnkey Cost</div>
                  <div id="res-gross-cost" style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700;">$34,300</div>
                </div>
                <div>
                  <div style="font-size: 13px; color: var(--accent-green); font-weight: 600;">30% Federal Tax Credit (§ 25D)</div>
                  <div id="res-itc-credit" style="font-family: var(--font-condensed); font-size: 28px; font-weight: 700; color: var(--accent-green);">-$10,290</div>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding: 20px 0; border-bottom: 1px solid var(--border-hairline);">
                <div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Net Investment After 30% ITC</div>
                  <div id="res-net-cost" style="font-family: var(--font-condensed); font-size: 32px; font-weight: 700; color: var(--accent-blue);">$24,010</div>
                </div>
                <div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Annual Solar Production</div>
                  <div id="res-annual-kwh" style="font-family: var(--font-condensed); font-size: 32px; font-weight: 700;">15,900 kWh/yr</div>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding-top: 20px;">
                <div>
                  <div style="font-size: 13px; color: var(--text-secondary);">Estimated Year-1 Bill Savings</div>
                  <div id="res-yr1-savings" style="font-family: var(--font-condensed); font-size: 26px; font-weight: 700; color: var(--accent-green);">$2,544 / yr</div>
                </div>
                <div>
                  <div style="font-size: 13px; color: var(--text-secondary);">25-Year Cumulative Net Return</div>
                  <div id="res-25yr-savings" style="font-family: var(--font-condensed); font-size: 26px; font-weight: 700; color: var(--accent-green);">+$68,400</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- US STATE SOLAR ATLAS TABLE -->
      <section class="ax-section" id="state-atlas" style="background: var(--bg-soft);">
        <div class="container">
          <div style="max-width: 820px; margin-bottom: 32px;">
            <span class="ax-eyebrow">NREL NSRDB Telemetry · State-by-State Solar & Storage Comparison</span>
            <h2 class="ax-h2">2026 US SOLAR ATLAS: TOP RESIDENTIAL STATES BY SOLAR YIELD & REBATES</h2>
            <p class="ax-sub">
              Comparison of specific photovoltaic yield (kWh per kW installed), average retail utility rates, and state-level tax exemptions across primary US residential solar markets.
            </p>
          </div>

          <div class="ax-table-wrap">
            <table class="ax-table">
              <thead>
                <tr>
                  <th>State / Utility Market</th>
                  <th>Major Metro Areas Covered</th>
                  <th>Specific Yield (NREL)</th>
                  <th>Avg Utility Rate</th>
                  <th>Recommended Storage</th>
                  <th>State & Federal Incentives (2026)</th>
                  <th>SME-2026 Score</th>
                </tr>
              </thead>
              <tbody>
                {usStatesData.map((s) => (
                  <tr>
                    <td><strong>{s.name}</strong></td>
                    <td>{s.cities}</td>
                    <td><strong>{s.yieldKwhKw} kWh/kW</strong></td>
                    <td>${s.elecRateUsd.toFixed(2)}/kWh</td>
                    <td>{s.recommendedBatteryKwh} kWh LFP</td>
                    <td>{s.stateIncentive}</td>
                    <td><span class="ax-badge ax-badge--blue">{s.smeScore}/100</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 2026 SYSTEM COST & 30% ITC BENCHMARK TABLE -->
      <section class="ax-section" id="cost-benchmarks">
        <div class="container">
          <div style="max-width: 820px; margin-bottom: 32px;">
            <span class="ax-eyebrow">2026 Turnkey Pricing Matrix · IRS Form 5695 (§ 25D)</span>
            <h2 class="ax-h2">SOLAR SYSTEM COST & 30% TAX CREDIT BENCHMARKS (6 KW TO 15 KW)</h2>
            <p class="ax-sub">
              National median turnkey installation costs before and after the 30% Federal Residential Clean Energy Credit, including standalone rooftop arrays and whole-home LFP battery backup bundles.
            </p>
          </div>

          <div class="ax-table-wrap">
            <table class="ax-table">
              <thead>
                <tr>
                  <th>System Configuration</th>
                  <th>Roof Footprint</th>
                  <th>Gross Cost (Before ITC)</th>
                  <th>30% Federal Tax Credit</th>
                  <th>Net Cost After ITC</th>
                  <th>Annual Generation</th>
                  <th>Est. 25-Year Savings</th>
                </tr>
              </thead>
              <tbody>
                {usCostTable.map((r) => (
                  <tr>
                    <td><strong>{r.size}</strong></td>
                    <td>{r.panels}</td>
                    <td>{r.grossUsd}</td>
                    <td style="color: var(--accent-green); font-weight: 600;">{r.itcCredit}</td>
                    <td><strong>{r.netUsd}</strong></td>
                    <td>{r.annualYield}</td>
                    <td style="color: var(--accent-green); font-weight: 600;">{r.savings25Yr}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- WHOLE-HOME BATTERY & MODULAR SOLAR GENERATOR COMPARISON -->
      <section class="ax-section" id="battery-comparison" style="background: var(--bg-soft);">
        <div class="container">
          <div style="max-width: 820px; margin-bottom: 32px;">
