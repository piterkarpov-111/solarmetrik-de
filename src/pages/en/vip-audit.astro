---
import '../../styles/global.css';

const title = 'Verified Reader Access: 2026 Solar Tax Credit & Whole-Home Battery Partner Portal — SOLARMETRIK';
const description =
  'Exclusive SOLARMETRIK reader portal: 30% Federal Solar Tax Credit (§ 25D) homeowner quotes and up to 40% off verified LFP whole-home solar backup systems.';

const usShowcaseProducts = [
  {
    id: 'us-rooftop-cpl-quote',
    badge: '#1 Ranked Turnkey Solar + 30% Federal ITC',
    category: 'Custom Rooftop Solar + 13.5 kWh LFP Battery Quote',
    title: '2026 Homeowner Solar & Battery Rebate Match (3 Verified Local Installer Quotes)',
    specs: 'Includes full 30% IRS § 25D Federal Tax Credit qualification, net-metering utility filing, and $0-down solar financing check for your property address.',
    oldPrice: '$28,500 avg',
    newPrice: '$17,640 Net (after 30% ITC)',
    discountTag: '30% Federal Tax Credit + Utility Rebate',
    ctaText: 'Check Your Roof & Claim 30% Tax Credit Quote →',
    offerKey: 'us_cpl_primary_url',
    defaultUrl: 'https://solarmetrik.de/en#us-calculator',
    isPrimaryCpl: true
  },
  {
    id: 'us-ecoflow-delta-pro-ultra',
    badge: 'Lab Verified · 240V Whole-Home Backup',
    category: 'Modular Whole-Home Solar Generator (6 kWh – 30 kWh)',
    title: 'EcoFlow DELTA Pro Ultra + Smart Home Panel 2 + Solar Bundle',
    specs: '7,200W–21,600W 120V/240V split-phase output · Runs central A/C, well pump & EV charger · Eligible for 30% Federal Tax Credit (§ 25D ≥ 3 kWh).',
    oldPrice: '$7,499',
    newPrice: '$4,699 (or $3,289 after 30% ITC)',
    discountTag: 'Save 37% + 30% IRS Tax Credit Eligible',
    ctaText: 'Claim Partner Discount at EcoFlow US →',
    offerKey: 'us_ecoflow_url',
    defaultUrl: 'https://us.ecoflow.com/?utm_source=solarmetrik&code=SOLAR26',
    isPrimaryCpl: false
  },
  {
    id: 'us-bluetti-ac500-ep900',
    badge: 'Hurricane & Blackout Grade · LiFePO4',
    category: 'Expandable Home Battery Backup (5,000W / 6,144Wh)',
    title: 'BLUETTI AC500 + 2× B300S LFP Home Backup & 1200W Solar Kit',
    specs: '6,000+ LiFePO4 charge cycles · 24/7 UPS grid-outage switchover in <20ms · Plug-and-play or sub-panel integration.',
    oldPrice: '$6,299',
    newPrice: '$3,799 (with Partner Code)',
    discountTag: 'Save 40% ($2,500 Off Bundle)',
    ctaText: 'Claim 40% Off at BLUETTI Official Store →',
    offerKey: 'us_bluetti_url',
    defaultUrl: 'https://www.bluettipower.com/?utm_source=solarmetrik&code=SOLAR26',
    isPrimaryCpl: false
  },
  {
    id: 'us-a1solar-bifacial-pallet',
    badge: 'Wholesale Tier-1 Hardware · 90-Day Price Lock',
    category: '10 kW N-Type Bifacial Solar Pallet + 48V Hybrid Inverter',
    title: 'A1 SolarStore 10 kW Complete Hybrid Off-Grid / Grid-Tie Kit',
    specs: '24× 430W N-Type TOPCon Bifacial Panels + 10kW Split-Phase Hybrid Inverter · Fast US domestic freight from regional warehouses.',
    oldPrice: '$14,800',
    newPrice: '$9,250 ($6,475 after 30% ITC)',
    discountTag: 'Save 38% vs. Retail Turnkey Markup',
    ctaText: 'View Wholesale Kit at A1 SolarStore →',
    offerKey: 'us_a1solar_url',
    defaultUrl: 'https://a1solarstore.com/?utm_source=solarmetrik',
    isPrimaryCpl: false
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
    />
    <style>
      .vip-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 24px;
      }
      .vip-card {
        background: #ffffff;
        border: 1.5px solid var(--border-hairline);
        border-radius: 12px;
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      }
      .vip-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 36px rgba(15, 76, 129, 0.08);
        border-color: var(--accent-blue);
      }
      .vip-card--featured {
        border: 2px solid var(--accent-blue);
        background: linear-gradient(180deg, #f7faff 0%, #ffffff 35%);
      }
      .vip-trust-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        background: #ffffff;
        border: 1px solid var(--border-hairline);
        border-radius: 10px;
        padding: 18px 24px;
        margin-bottom: 40px;
      }
      @media (max-width: 860px) {
        .vip-trust-bar {
          grid-template-columns: 1fr 1fr;
        }
      }
    </style>
  </head>
  <body style="background: var(--bg-soft);">
    <header class="ax-header">
      <div class="ax-header__utility">
        <span>Verified Homeowner Access · NREL PVWatts® & IRS Form 5695 (§ 25D) Update</span>
        <a href="/en#us-calculator">US 30% Tax Credit Calculator →</a>
        <a href="/en">SOLARMETRIK International →</a>
      </div>
      <div class="ax-header__main">
        <a href="/en" class="ax-logo">
          SOLARMETRIK<span class="ax-logo__fin"></span>
        </a>
        <div style="font-size: 13px; color: var(--accent-green); font-weight: 600;">
          ● November 2026 Homeowner Partner Terms Active
        </div>
      </div>
    </header>

    <main>
      <section class="ax-section" style="padding-top: 44px; padding-bottom: 64px;">
        <div class="container">
          <!-- PERSONALIZED HERO BANNER -->
          <div
            style="background: #ffffff; border: 1px solid var(--border-hairline); border-radius: 14px; padding: 36px 40px; margin-bottom: 28px; box-shadow: 0 10px 30px rgba(15, 76, 129, 0.04);"
          >
            <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px;">
              <span
                style="display: inline-block; padding: 5px 12px; border-radius: 6px; background: var(--accent-blue-light); color: var(--accent-blue); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;"
              >
                Verified Homeowner Access · November 2026 Report Update
              </span>
              <span id="us-property-badge" style="font-size: 13px; color: var(--text-secondary); font-weight: 600;">
                Property Qualification: 30% Federal Residential Clean Energy Credit (§ 25D)
              </span>
            </div>

            <h1 class="ax-h1" style="margin-bottom: 16px;" id="us-hero-title">
              EXCLUSIVE UP TO 40% OFF VERIFIED HOME SOLAR & LFP BATTERY SYSTEMS + 30% FEDERAL TAX CREDIT
            </h1>

            <p class="ax-sub" style="max-width: 920px; margin-bottom: 24px;">
              Following our November 2026 NREL solar irradiance and LFP storage efficiency audit, verified homeowners gain direct access to pre-negotiated partner pricing on whole-home solar backup systems and priority local installer rebates in <strong>California, Florida, Arizona, Texas, and Louisiana</strong>.
            </p>

            <!-- INTERACTIVE PROMO CODE BAR -->
            <div
              style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; background: var(--bg-soft); border: 1px dashed var(--accent-blue); border-radius: 10px; padding: 16px 22px;"
            >
              <div>
                <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600;">
                  Verified Reader Partner Code (Auto-Applied via Links Below):
                </div>
                <div style="font-size: 14px; color: var(--text-secondary); margin-top: 2px;">
                  Stacks with the 30% IRS § 25D Federal Tax Credit on qualifying solar & battery bundles ≥ 3 kWh.
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 12px;">
                <code
                  id="us-promo-code"
                  style="font-family: var(--font-condensed); font-size: 24px; font-weight: 700; letter-spacing: 0.08em; background: #ffffff; padding: 6px 16px; border-radius: 6px; border: 1px solid var(--border-button); color: var(--accent-blue);"
                >
                  SOLAR26
                </code>
                <button
                  type="button"
                  id="us-copy-btn"
                  class="ax-btn ax-btn--primary"
                  style="padding: 10px 18px; font-size: 13.5px;"
                >
                  Copy Code
                </button>
              </div>
            </div>
          </div>

          <!-- TRUST BAR -->
          <div class="vip-trust-bar">
            <div>
              <div style="font-family: var(--font-condensed); font-size: 22px; font-weight: 700; color: var(--accent-blue);">30% Federal ITC</div>
              <div style="font-size: 12.5px; color: var(--text-secondary);">Uncapped IRS § 25D credit on rooftop PV & LFP batteries</div>
            </div>
            <div>
              <div style="font-family: var(--font-condensed); font-size: 22px; font-weight: 700; color: var(--accent-green);">Up to 40% Partner Off</div>
              <div style="font-size: 12.5px; color: var(--text-secondary);">Direct manufacturer & installer fleet pricing</div>
            </div>
            <div>
              <div style="font-family: var(--font-condensed); font-size: 22px; font-weight: 700; color: var(--text-primary);">UL9540 & LFP Rated</div>
              <div style="font-size: 12.5px; color: var(--text-secondary);">6,000+ cycle LiFePO4 whole-home backup safety</div>
            </div>
            <div>
              <div style="font-family: var(--font-condensed); font-size: 22px; font-weight: 700; color: var(--accent-green);">Fast US Domestic</div>
              <div style="font-size: 12.5px; color: var(--text-secondary);">Priority dispatch & certified local installation</div>
            </div>
          </div>

          <!-- PRODUCT & OFFER SHOWCASE GRID -->
          <div class="vip-grid">
            {usShowcaseProducts.map((item) => (
              <div class:list={['vip-card', { 'vip-card--featured': item.isPrimaryCpl }]}>
                <div>
                  <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px;">
                    <span
                      style="display: inline-block; padding: 4px 10px; border-radius: 5px; background: var(--accent-blue-light); color: var(--accent-blue); font-size: 11.5px; font-weight: 700; text-transform: uppercase;"
                    >
                      {item.badge}
                    </span>
                    <span
                      style="display: inline-block; padding: 4px 10px; border-radius: 5px; background: var(--accent-green-light); color: var(--accent-green); font-size: 11.5px; font-weight: 700;"
                    >
                      {item.discountTag}
                    </span>
                  </div>

                  <div style="font-size: 12.5px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-bottom: 6px;">
                    {item.category}
                  </div>
                  <h2 style="font-family: var(--font-condensed); font-size: 25px; font-weight: 700; line-height: 1.15; margin-bottom: 12px; color: var(--text-primary);">
                    {item.title}
                  </h2>
                  <p style="font-size: 14px; color: var(--text-secondary); line-height: 1.55; margin-bottom: 20px;">
                    {item.specs}
                  </p>
                </div>

                <div>
                  <div style="padding: 14px 0; border-top: 1px solid var(--border-hairline); border-bottom: 1px solid var(--border-hairline); margin-bottom: 18px; display: flex; align-items: baseline; justify-content: space-between;">
                    <div>
                      <span style="font-size: 12px; color: var(--text-muted); display: block;">Standard Retail Price:</span>
                      <span style="font-size: 15px; color: var(--text-muted); text-decoration: line-through;">{item.oldPrice}</span>
                    </div>
                    <div style="text-align: right;">
                      <span style="font-size: 12px; color: var(--accent-green); font-weight: 600; display: block;">Verified Reader Price:</span>
                      <strong style="font-family: var(--font-condensed); font-size: 26px; color: var(--text-primary);">{item.newPrice}</strong>
                    </div>
                  </div>

                  <a
                    href={item.defaultUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ax-btn ax-btn--primary js-offer-link"
                    data-offer-id={item.id}
                    data-offer-key={item.offerKey}
                    style="width: 100%; justify-content: center; padding: 14px 20px; font-size: 14.5px; font-weight: 600;"
                  >
                    {item.ctaText}
                  </a>
                </div>
              </div>
            ))}
          </div>

          <!-- 3 STEPS HOW TO CLAIM -->
          <div
            style="margin-top: 48px; background: #ffffff; border: 1px solid var(--border-hairline); border-radius: 12px; padding: 32px 36px;"
          >
            <h3 class="ax-h3" style="margin-bottom: 18px;">
              HOW TO CLAIM YOUR READER DISCOUNT & 30% FEDERAL TAX CREDIT (3 STEPS)
            </h3>
            <div class="ax-cards-3">
              <div>
                <strong style="color: var(--accent-blue); font-size: 15px; display: block; margin-bottom: 6px;">Step 1: Select Your Solar or Battery Option</strong>
                <p style="font-size: 14px; color: var(--text-secondary);">
                  Click any verified installer quote or whole-home battery bundle above. Your SOLARMETRIK partner session is activated automatically.
                </p>
              </div>
              <div>
                <strong style="color: var(--accent-blue); font-size: 15px; display: block; margin-bottom: 6px;">Step 2: Apply Partner Code at Checkout</strong>
                <p style="font-size: 14px; color: var(--text-secondary);">
                  For hardware orders (EcoFlow, BLUETTI, A1 SolarStore), enter code <strong>SOLAR26</strong> at checkout for up to 40% off retail pricing.
                </p>
              </div>
              <div>
                <strong style="color: var(--accent-blue); font-size: 15px; display: block; margin-bottom: 6px;">Step 3: File IRS Form 5695 for 30% Back</strong>
                <p style="font-size: 14px; color: var(--text-secondary);">
                  Both rooftop installations and standalone home battery backup systems ≥ 3 kWh qualify for the uncapped 30% Federal Residential Clean Energy Credit.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="ax-footer">
      <div class="container">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 12.5px; color: var(--text-muted);">
          <span>© 2026 SOLARMETRIK International (solarmetrik.de/en) · Verified Homeowner Partner Portal</span>
          <div style="display: flex; gap: 16px;">
            <a href="/en">US & EU Calculator</a>
            <a href="/">🇩🇪 German Portal</a>
            <a href="/impressum">Legal Notice</a>
            <a href="/datenschutz">Privacy Policy</a>
            <a href="/unsubscribe" id="footer-unsub-link">Unsubscribe</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const params = new URLSearchParams(window.location.search);
        const userEmail = (params.get('u') || params.get('email') || '').trim();
        const userAddr = (params.get('addr') || params.get('plz') || '').trim();
        const userName = (params.get('name') || '').trim();

        const badgeEl = document.getElementById('us-property-badge');
        const titleEl = document.getElementById('us-hero-title');
        const unsubLink = document.getElementById('footer-unsub-link');

        if (userAddr && badgeEl) {
          badgeEl.textContent = 'Property Audit Unlocked for: ' + userAddr + ' (30% Federal ITC Eligible)';
        }
        if (userName && titleEl) {
          titleEl.textContent = 'PREPARED FOR ' + userName.toUpperCase() + ': UP TO 40% OFF SOLAR & BATTERY BACKUP + 30% TAX CREDIT';
        }
        if (userEmail && unsubLink) {
          unsubLink.href = '/unsubscribe?email=' + encodeURIComponent(userEmail);
        }

        // 1. Log Visit to Cloudflare Tracker Worker
        fetch('https://track.solarmetrik.de/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'visit',
            email: userEmail || 'anonymous',
            region: 'US',
            page: '/en/vip-audit',
            extra: userAddr
          })
        }).catch(function () {});

        // 2. Load Dynamic Affiliate Links from Worker Config
        fetch('https://track.solarmetrik.de/offers')
          .then(function (r) { return r.json(); })
          .then(function (cfg) {
            if (cfg.promo_code_us) {
              const codeEl = document.getElementById('us-promo-code');
              if (codeEl) codeEl.textContent = cfg.promo_code_us;
            }
            document.querySelectorAll('.js-offer-link').forEach(function (link) {
              const key = link.getAttribute('data-offer-key');
              if (key && cfg[key]) {
                link.setAttribute('href', cfg[key]);
              }
            });
          })
          .catch(function () {});

        // 3. Track Clicks on Offer Cards
        document.querySelectorAll('.js-offer-link').forEach(function (link) {
          link.addEventListener('click', function () {
            const offerId = link.getAttribute('data-offer-id') || 'unknown';
            const payload = JSON.stringify({
              type: 'click',
              email: userEmail || 'anonymous',
              region: 'US',
              offer: offerId,
              page: '/en/vip-audit',
              extra: userAddr
            });
            if (navigator.sendBeacon) {
              navigator.sendBeacon('https://track.solarmetrik.de/track', payload);
            } else {
              fetch('https://track.solarmetrik.de/track', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: payload,
                keepalive: true
              }).catch(function () {});
            }
          });
        });

        // 4. Copy Promo Code button
        const copyBtn = document.getElementById('us-copy-btn');
        const codeEl = document.getElementById('us-promo-code');
        if (copyBtn && codeEl) {
          copyBtn.addEventListener('click', function () {
            navigator.clipboard.writeText(codeEl.textContent.trim()).then(function () {
              copyBtn.textContent = '✓ Copied! Code Auto-Applied';
            });
          });
        }
      })();
    </script>
  </body>
</html>
