---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EeatVerifyBar from '../../../components/EeatVerifyBar.astro';
import {
  bundeslaender,
  getStaedteByBundesland,
  calculateLocalSystemScenario,
  getMonthlyYieldBreakdown,
  formatEur,
  formatNumber,
  type BundeslandData
} from '../../../lib/data';

export function getStaticPaths() {
  return bundeslaender.map((land) => ({
    params: { bundesland: land.slug },
    props: { land }
  }));
}

interface Props {
  land: BundeslandData;
}

const { land } = Astro.props;
const cities = getStaedteByBundesland(land.slug);

const scenarios = [
  calculateLocalSystemScenario(
    land.specificYieldKwhKwp,
    land.avgCostPerKwpEur,
    land.avgElectricityPriceCt,
    6,
    5,
    2800,
    '2 Personen (Kompakt-EFH)'
  ),
  calculateLocalSystemScenario(
    land.specificYieldKwhKwp,
    land.avgCostPerKwpEur,
    land.avgElectricityPriceCt,
    10,
    10,
    4500,
    'Familie 3–4 P. (Referenz)'
  ),
  calculateLocalSystemScenario(
    land.specificYieldKwhKwp,
    land.avgCostPerKwpEur,
    land.avgElectricityPriceCt,
    15,
    15,
    8000,
    'Haus + Wärmepumpe & Wallbox'
  )
];

const monthly10kWp = getMonthlyYieldBreakdown(land.specificYieldKwhKwp * 10);

const stateFaqs = [
  {
    q: `Wie hoch ist der durchschnittliche Photovoltaik-Ertrag in ${land.name} im Jahr 2026?`,
    a: `Nach den langjährigen Strahlungsdaten des Deutschen Wetterdienstes (DWD) und PVGIS liegt die mittlere Globalstrahlung in ${land.name} bei ${formatNumber(land.globalRadiationKwhM2)} kWh/m² pro Jahr (${formatNumber(land.sunHoursPerYear)} Sonnenstunden). Eine optimal um ${land.optimalTiltAngleDeg}° nach Süden geneigte Solaranlage erzielt im Landesdurchschnitt ${formatNumber(land.specificYieldKwhKwp)} kWh Strom pro installiertem kWp — eine 10-kWp-Anlage produziert somit rund ${formatNumber(land.specificYieldKwhKwp * 10)} kWh Solarstrom jährlich.`
  },
  {
    q: `Gilt in ${land.name} 2026 eine gesetzliche Solarpflicht für Wohnhäuser?`,
    a: `${land.solarpflicht.effectiveRule2026} (Status Neubau Wohngebäude: ${land.solarpflicht.neubauWohngebaeude ? 'Verpflichtend' : 'Keine Pflicht'}; Status Dachsanierung im Bestand: ${land.solarpflicht.dachsanierungBestand ? 'Verpflichtend' : 'Freiwillig'}).`
  },
  {
    q: `Welche Photovoltaik-Förderung gibt es 2026 in ${land.name}?`,
    a: `In ${land.name} gilt das Programm "${land.landesfoerderung.programName}" (${land.landesfoerderung.status2026}). ${land.landesfoerderung.details} Zusätzlich profitieren alle privaten Anlagen bis 30 kWp bundesweit vom Nullsteuersatz (0 % MwSt. nach § 12 Abs. 3 UStG), der Einkommensteuerbefreiung (§ 3 Nr. 72 EStG) sowie der 20-jährigen EEG-Einspeisevergütung.`
  },
  {
    q: `Was kostet eine 10-kWp-Solaranlage mit Speicher in ${land.name} 2026?`,
    a: `Das regionale Handwerker- und Montagepreisniveau in ${land.name} liegt 2026 bei durchschnittlich ${formatEur(land.avgCostPerKwpEur)} pro kWp (ohne Speicher). Eine schlüsselfertige 10-kWp-Komplettanlage inklusive 10-kWh-Batteriespeicher, Hybrid-Wechselrichter und Montage kostet im Schnitt ${formatEur(land.avgTurnkey10kWpWithStorageEur)} (0 % MwSt.) und amortisiert sich bei einem lokalen Strompreis von ${formatNumber(land.avgElectricityPriceCt, 1)} ct/kWh nach ca. ${formatNumber(land.amortisationYears, 1)} Jahren.`
  }
];

const stateSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: stateFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a
      }
    }))
  }
];
---

<BaseLayout
  title={`Photovoltaik ${land.name} 2026: Förderung, Solarpflicht, Ertrag & Kosten | SOLARMETRIK`}
  description={`Photovoltaik-Analyse ${land.name} (${land.code}) 2026: ${land.specificYieldKwhKwp} kWh/kWp Ertrag, Solarpflicht-Gesetz, ${land.landesfoerderung.programName} & Preise für ${cities.length} Städte.`}
  canonicalPath={`/solaratlas/${land.slug}`}
  activeSection="atlas"
  schema={stateSchema}
>
  <section class="ax-section" style="padding-top: 44px;">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Startseite', href: '/' },
          { label: 'Solar-Atlas Deutschland', href: '/solaratlas' },
          { label: `Photovoltaik ${land.name} (${land.code})` }
        ]}
      />

      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 24px;">
        <div style="max-width: 820px;">
          <span class="ax-eyebrow">
            Bundesland-Dossier ({land.code}) · Landeshauptstadt: {land.capital} · SME-2026 Score: {land.solarmetrikScore}/100
          </span>
          <h1 class="ax-h1">
            PHOTOVOLTAIK IN {land.name.toUpperCase()} 2026: ERTRAG, FÖRDERUNG & SOLARPFICHT
          </h1>
          <p class="ax-sub">
            Unabhängige Ingenieur-Auswertung für {land.name}: Mit durchschnittlich{' '}
            <strong>{formatNumber(land.specificYieldKwhKwp)} kWh pro kWp</strong> ({formatNumber(land.sunHoursPerYear)}{' '}
            Sonnenstunden/Jahr) und einem schlüsselfertigen 10-kWp-Systempreis von ca.{' '}
            <strong>{formatEur(land.avgTurnkey10kWpWithStorageEur)}</strong> erreicht {land.name} im
            bundesweiten SOLARMETRIK-Effizienzranking <strong>{land.solarmetrikScore} von 100 Punkten</strong>.
          </p>
        </div>

        <a href={`/rechner?state=${land.slug}`} class="ax-btn ax-btn--primary">
          Im PV-Rechner mit {land.name}-Daten rechnen →
        </a>
      </div>

      <EeatVerifyBar updatedDate="04. November 2026" readingTimeMin={5} />

      <!-- 4 CORE KPI CARDS FOR THIS FEDERAL STATE -->
      <div class="ax-cards-4" style="margin-top: 32px;">
        <div class="kpi-card">
          <div class="kpi-card__label">Spezifischer PV-Ertrag (DWD/PVGIS)</div>
          <div class="kpi-card__value">{formatNumber(land.specificYieldKwhKwp)} kWh</div>
          <div class="kpi-card__note">
            Pro installiertem kWp/Jahr · Globalstrahlung: {formatNumber(land.globalRadiationKwhM2)} kWh/m² ·
            Optimaler Neigungswinkel: {land.optimalTiltAngleDeg}° Süd.
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-card__label">10 kWp + 10 kWh Speicher (0% MwSt)</div>
          <div class="kpi-card__value">{formatEur(land.avgTurnkey10kWpWithStorageEur)}</div>
          <div class="kpi-card__note">
            Regionaler Montagepreis ohne Speicher: Ø {formatEur(land.avgCostPerKwpEur)}/kWp ·
            Lokaler Stromtarif: Ø {formatNumber(land.avgElectricityPriceCt, 1)} ct/kWh.
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-card__label">Ø Amortisation & 20-J.-Rendite</div>
          <div class="kpi-card__value" style="color: var(--accent-green);">
            {formatNumber(land.amortisationYears, 1)} Jahre
          </div>
          <div class="kpi-card__note">
            Kumulierter 20-Jahre-Nettovorteil nach Abzug der Anschaffungskosten:{' '}
            <strong>+ {formatEur(land.twentyYearNetProfitEur)}</strong>.
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-card__label">Solarpflicht-Status 2026 ({land.code})</div>
          <div class="kpi-card__value" style="font-size: 28px;">
            {land.solarpflicht.neubauWohngebaeude || land.solarpflicht.dachsanierungBestand
              ? 'Gesetzlich Aktiv'
              : 'Freiwillig'}
          </div>
          <div class="kpi-card__note">
            Neubau: {land.solarpflicht.neubauWohngebaeude ? 'Pflicht' : 'Freiwillig'} ·
            Dachsanierung: {land.solarpflicht.dachsanierungBestand ? 'Pflicht' : 'Freiwillig'}.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EDITORIAL DEEP DIVE (750-950 WORDS, H2 CHUNKS FOR RAG) -->
  <section class="ax-section ax-section--soft">
    <div class="container" style="max-width: 1060px;">
      <div class="toc-box">
        <div class="toc-box__title">Inhaltsverzeichnis: Landesanalyse {land.name} 2026</div>
        <div class="toc-box__list">
          <a href="#strahlungsdaten-ertrag" class="toc-box__link">1. Sonneneinstrahlung & Monatsverlauf</a>
          <a href="#foerderung-landesprogramme" class="toc-box__link">2. Landesförderung & Zuschüsse 2026</a>
          <a href="#solarpflicht-gesetz" class="toc-box__link">3. Solarpflicht bei Neubau & Dachsanierung</a>
          <a href="#wirtschaftlichkeit-staedte" class="toc-box__link">4. Preistabelle & Städte in {land.name}</a>
        </div>
      </div>

      <h2 id="strahlungsdaten-ertrag" class="editorial-h2">
        1. SONNENEINSTRAHLUNG, NEIGUNGSWINKEL & JAHRESERTRAG IN {land.name.toUpperCase()}
      </h2>
      <p class="editorial-p">
        Die meteorologischen Messreihen des Deutschen Wetterdienstes (DWD) weisen für{' '}
        <strong>{land.name}</strong> eine durchschnittliche jährliche Globalstrahlung von{' '}
        <strong>{formatNumber(land.globalRadiationKwhM2)} kWh pro Quadratmeter</strong> bei rund{' '}
        <strong>{formatNumber(land.sunHoursPerYear)} Sonnenstunden</strong> aus. Aufgrund der
        geografischen Breite erreicht ein nach Süden ausgerichtetes Schrägdach in {land.name} bei
        einem <strong>optimalen Neigungswinkel von {land.optimalTiltAngleDeg}°</strong> den höchsten
        spezifischen Jahresertrag von durchschnittlich{' '}
        <strong>{formatNumber(land.specificYieldKwhKwp)} kWh pro installiertem Kilowatt-Peak (kWp)</strong>.
      </p>
      <p class="editorial-p">
        Für eine typische 10-kWp-Einfamilienhausanlage bedeutet dies in {land.name} eine
        jährliche Stromproduktion von rund <strong>{formatNumber(land.specificYieldKwhKwp * 10)} kWh</strong>.
        Selbst bei einer Ost-West-Dachbelegung (±90° Azimut und 25°–30° Dachneigung) werden noch
        etwa <strong>{formatNumber(Math.round(land.specificYieldKwhKwp * 0.85))} kWh/kWp</strong> erreicht,
        wobei die Erzeugungskurve breiter über den Vor- und Nachmittag verteilt wird.
      </p>

      <div class="kpi-card" style="margin: 28px 0;">
        <h3 class="ax-h3">
          Monatliche Stromerzeugung einer 10-kWp-Anlage in {land.name} ({formatNumber(land.specificYieldKwhKwp * 10)} kWh/Jahr)
        </h3>
        <div class="monthly-bars">
          {monthly10kWp.map((m) => (
            <div class="monthly-bar-col">
              <span class="monthly-bar-val">{m.kwh}</span>
              <div
                class="monthly-bar-fill"
                style={`height: ${Math.round((m.sharePercent / 15) * 100)}%;`}
              ></div>
              <span class="monthly-bar-label">{m.month}</span>
            </div>
          ))}
        </div>
      </div>

      <h2 id="foerderung-landesprogramme" class="editorial-h2">
        2. PHOTOVOLTAIK-FÖRDERUNG 2026 IN {land.name.toUpperCase()} & NETZBETREIBER
      </h2>
      <div class="clean-summary-box">
        <div style="font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-blue); font-weight: 600; margin-bottom: 6px;">
          Aktuelles Förderprogramm in {land.name} (Stand November 2026)
        </div>
        <div style="font-size: 18px; font-weight: 700; margin-bottom: 8px;">
          {land.landesfoerderung.programName} — Status: {land.landesfoerderung.status2026}
        </div>
        <p style="font-size: 15px; color: var(--text-secondary);">
          {land.landesfoerderung.details}
        </p>
      </div>
      <p class="editorial-p">
        Neben den landesspezifischen und kommunalen Förderinstrumenten profitieren Hausbesitzer in{' '}
        {land.name} im Jahr 2026 von vier bundesweiten Förder- und Entlastungssäulen: Erstens dem
        <strong>Nullsteuersatz (0 % MwSt. nach § 12 Abs. 3 UStG)</strong> auf alle Komponenten
        und die Dachmontage; zweitens der vollständigen <strong>Einkommensteuerbefreiung nach
        § 3 Nr. 72 EStG</strong> für Anlagen bis 30 kWp; drittens der 20-jährigen
        <strong>EEG-Einspeisevergütung</strong> (7,70 ct/kWh Teileinspeisung bzw. 12,22 ct/kWh
        Volleinspeisung bis 10 kWp bei Inbetriebnahme vor dem 31.12.2026); sowie viertens den
        reduzierten Netzentgelten nach <strong>§ 14a EnWG</strong>.
      </p>
      <p class="editorial-p">
        Die technische Anmeldung sowie der Zählerwechsel (Smart-Meter-Rollout / iMSys) erfolgen
        in {land.name} primär über die regionalen Verteilnetzbetreiber:{' '}
        <strong>{land.mainGridOperators.join(', ')}</strong> sowie die örtlichen Stadtwerke.
      </p>

      <h2 id="solarpflicht-gesetz" class="editorial-h2">
        3. GESETZLICHE SOLARPFICHT 2026 IN {land.name.toUpperCase()} (NEUBAU & DACHSANIERUNG)
      </h2>
      <p class="editorial-p">
        Für Bauherren und Eigentümer von Bestandsimmobilien in {land.name} gilt im Jahr 2026
        folgende verbindliche Rechtslage zur Solarpflicht:
      </p>
      <div class="clean-summary-box clean-summary-box--green">
        <strong>Rechtsstand {land.name} (11/2026):</strong> {land.solarpflicht.effectiveRule2026}
      </div>

      <h2 id="wirtschaftlichkeit-staedte" class="editorial-h2">
        4. KOSTEN- & RENDITETABELLE FÜR 6, 10 UND 15 KWP IN {land.name.toUpperCase()}
      </h2>
      <p class="editorial-p">
        Auf Basis des durchschnittlichen Haushaltsstrompreises in {land.name} von{' '}
        <strong>{formatNumber(land.avgElectricityPriceCt, 1)} ct/kWh</strong> und der regionalen
        Installationskosten von <strong>{formatEur(land.avgCostPerKwpEur)} pro kWp</strong> ergeben
        sich für das Jahr 2026 folgende Referenzwerte für drei typische Haushaltsgrößen:
      </p>

      <div class="clean-table-wrap" style="background: #ffffff; padding: 8px 20px; border-radius: var(--radius-photo);">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Systemgröße</th>
              <th>Jahresertrag ({land.code})</th>
              <th>Komplettpreis (0% MwSt)</th>
              <th>Ersparnis + EEG / Jahr</th>
              <th>Amortisation</th>
              <th>20-J. Nettovorteil</th>
            </tr>
          </thead>
          <tbody>
            {scenarios.map((sc) => (
              <tr>
                <td>
                  <strong>{sc.kWp} kWp + {sc.storageKwh} kWh</strong>
                  <div style="font-size: 12px; color: var(--text-muted);">{sc.householdLabel}</div>
                </td>
                <td>{formatNumber(sc.annualYieldKwh)} kWh</td>
                <td><strong>{formatEur(sc.turnkeyCostEur)}</strong></td>
                <td>{formatEur(sc.totalAnnualBenefitYear1Eur)} / Jahr</td>
                <td>{formatNumber(sc.amortisationYears, 1)} Jahre</td>
                <td style="color: var(--accent-green); font-weight: 600;">
                  + {formatEur(sc.twentyYearNetProfitEur)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="editorial-h3">
        Alle geprüften Städte & lokalen Stadtwerke in {land.name}:
      </h3>
      <div class="clean-table-wrap" style="background: #ffffff; padding: 8px 20px; border-radius: var(--radius-photo);">
        <table class="clean-table">
          <thead>
            <tr>
              <th>Stadt & PLZ</th>
              <th>Spezifischer Ertrag</th>
              <th>Optimaler Winkel</th>
              <th>10 kWp + Speicher</th>
              <th>Lokaler Netzbetreiber</th>
              <th>Analyse</th>
            </tr>
          </thead>
          <tbody>
            {cities.map((c) => (
              <tr>
                <td>
                  <a
                    href={`/solaratlas/${c.bundeslandSlug}/${c.slug}`}
                    style="font-weight: 600; color: var(--accent-blue);"
                  >
                    {c.name} ({c.plzRange}) →
                  </a>
                </td>
                <td><strong>{c.specificYieldKwhKwp} kWh/kWp</strong></td>
                <td>{c.optimalTiltDeg}° Süd</td>
                <td>{formatEur(c.turnkey10kWpWithStorageEur)}</td>
                <td style="font-size: 13px;">{c.localGridOperator}</td>
                <td>
                  <a
                    href={`/solaratlas/${c.bundeslandSlug}/${c.slug}`}
                    style="color: var(--accent-blue); font-weight: 500;"
                  >
                    Details →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="editorial-h2">HÄUFIGE FRAGEN ZU PHOTOVOLTAIK IN {land.name.toUpperCase()}</h2>
      <div class="faq-list">
        {stateFaqs.map((f, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-question">
              <span>{f.q}</span>
              <span style="color: var(--accent-blue);">+</span>
            </summary>
            <div class="faq-answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
