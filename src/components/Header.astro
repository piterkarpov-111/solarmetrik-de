---
import { getAllBundeslaender, getAllStaedte } from '../lib/data';

interface Props {
  isHero?: boolean;
  activeSection?: 'atlas' | 'rechner' | 'ratgeber' | 'methodik' | 'home';
}

const { isHero = false, activeSection = 'home' } = Astro.props;
const bundeslaender = getAllBundeslaender();
const topStaedte = getAllStaedte().slice(0, 12);
const allStaedteSearch = getAllStaedte().map((s) => ({
  name: s.name,
  plz: s.plzRange,
  url: `/solaratlas/${s.bundeslandSlug}/${s.slug}`
}));
---

<header class:list={['ax-header', { 'ax-header--hero': isHero }]} id="ax-site-header">
  <div class="ax-header__utility">
    <span>Datenbasis: Bundesnetzagentur & DWD (Stand: 11/2026)</span>
    <a href="/rechner">Wirtschaftlichkeitsrechner →</a>
    <a href="/foerderung-check">Förderung & PLZ-Check →</a>
    <a href="/ueber-uns">Über uns & Redaktion →</a>
  </div>

  <div class="ax-header__main">
    <a href="/" class="ax-logo" aria-label="SOLARMETRIK Startseite">
      SOLARMETRIK<span class="ax-logo__fin"></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="ax-nav ax-nav--desktop" aria-label="Hauptnavigation">
      <div class="ax-nav__item">
        <a
          href="/solaratlas"
          class:list={['ax-nav__link', { active: activeSection === 'atlas' }]}
        >
          Solar-Atlas (16 Länder) ▾
        </a>

        <div class="ax-mega" role="region" aria-label="Solar-Atlas Deutschland Mega-Menü">
          <div class="ax-mega__grid">
            <div>
              <div class="ax-mega__heading">Alle 16 Bundesländer (SME-2026 Index)</div>
              <div class="ax-mega__list">
                {bundeslaender.map((land) => (
                  <a href={`/solaratlas/${land.slug}`} class="ax-mega__link">
                    <span>{land.name}</span>
                    <span class="ax-mega__score">{land.solarmetrikScore}/100</span>
                  </a>
                ))}
              </div>
            </div>

            <div>
              <div class="ax-mega__heading">Meistgeprüfte Städte 2026</div>
              <div class="ax-mega__list">
                {topStaedte.map((stadt) => (
                  <a
                    href={`/solaratlas/${stadt.bundeslandSlug}/${stadt.slug}`}
                    class="ax-mega__link"
                  >
                    <span>{stadt.name}</span>
                    <span class="ax-mega__score">{stadt.specificYieldKwhKwp} kWh/kWp</span>
                  </a>
                ))}
              </div>
              <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--border-hairline);">
                <a href="/solaratlas" style="font-size: 13px; font-weight: 600; color: var(--accent-blue);">
                  Alle 51 Städte & Regionen im Solar-Atlas ansehen →
                </a>
              </div>
            </div>

            <div>
              <div class="ax-mega__heading">Rechner & Ingenieur-Tools</div>
              <div class="ax-mega__list ax-mega__list--single">
                <a href="/rechner" class="ax-mega__link">
                  <strong>PV-Rendite & 360°-Dachrechner</strong>
                  <span>→</span>
                </a>
                <a href="/speicher-rechner" class="ax-mega__link">
                  <strong>Stromspeicher & Autarkie-Rechner</strong>
                  <span>→</span>
                </a>
                <a href="/foerderung-check" class="ax-mega__link">
                  <strong>Förderung, Solarpflicht & Stadtwerke</strong>
                  <span>→</span>
                </a>
                <a href="/methodik" class="ax-mega__link">
                  <span>SME-2026 Methodik & Formeln</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ax-nav__item">
        <a
          href="/rechner"
          class:list={['ax-nav__link', { active: activeSection === 'rechner' }]}
        >
          PV-Rechner & Speicher
        </a>
      </div>

      <div class="ax-nav__item">
        <a
          href="/foerderung-check"
          class="ax-nav__link"
        >
          Förderung 2026
        </a>
      </div>

      <div class="ax-nav__item">
        <a
          href="/ratgeber"
          class:list={['ax-nav__link', { active: activeSection === 'ratgeber' }]}
        >
          Ratgeber & EEG 2027
        </a>
      </div>

      <div class="ax-nav__item">
        <a
          href="/methodik"
          class:list={['ax-nav__link', { active: activeSection === 'methodik' }]}
        >
          Methodik
        </a>
      </div>
    </nav>

    <!-- Desktop Search -->
    <search role="search" aria-label="Stadt oder Postleitzahl suchen" class="ax-search--desktop">
      <form id="header-city-search-form" class="ax-search-box" onsubmit="return false;">
        <input
          type="search"
          id="header-city-search-input"
          class="ax-search-input"
          list="solarmetrik-cities-datalist"
          placeholder="Stadt oder PLZ (z.B. 80331)..."
          aria-label="Stadt oder PLZ suchen"
        />
        <datalist id="solarmetrik-cities-datalist">
          {allStaedteSearch.map((item) => (
            <option value={item.name} data-url={item.url}>{item.plz}</option>
          ))}
        </datalist>
      </form>
    </search>

    <!-- Mobile Hamburger Toggle Button -->
    <button
      type="button"
      id="ax-mobile-toggle"
      class="ax-mobile-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="ax-mobile-drawer"
    >
      <span class="ax-mobile-toggle__bar"></span>
      <span class="ax-mobile-toggle__bar"></span>
      <span class="ax-mobile-toggle__bar"></span>
    </button>
  </div>

  <!-- Mobile Slide-Down Navigation Drawer -->
  <div id="ax-mobile-drawer" class="ax-mobile-drawer" aria-hidden="true">
    <div class="ax-mobile-drawer__inner">
      <!-- Mobile Search Form -->
      <div class="ax-mobile-search">
        <form id="mobile-city-search-form" class="ax-mobile-search__form" onsubmit="return false;">
          <input
            type="search"
            id="mobile-city-search-input"
            class="ax-mobile-search__input"
            list="solarmetrik-cities-datalist-mobile"
            placeholder="Stadt oder PLZ suchen (z.B. 80331)..."
            aria-label="Stadt oder PLZ suchen"
            autocomplete="off"
          />
          <button type="submit" class="ax-mobile-search__btn" aria-label="Suchen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <datalist id="solarmetrik-cities-datalist-mobile">
            {allStaedteSearch.map((item) => (
              <option value={item.name} data-url={item.url}>{item.plz}</option>
            ))}
          </datalist>
        </form>
      </div>

      <!-- Mobile Navigation Links -->
      <nav class="ax-mobile-nav" aria-label="Mobile Navigation">
        <!-- Group 1: Solar-Atlas -->
        <div class="ax-mobile-nav__group">
          <div class="ax-mobile-nav__heading">Solar-Atlas & Regionen</div>
          <a href="/solaratlas" class:list={['ax-mobile-nav__link', { active: activeSection === 'atlas' }]}>
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">Solar-Atlas Deutschland</span>
              <span class="ax-mobile-nav__secondary">16 Bundesländer & 51 Großstädte</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>

          <details class="ax-mobile-states-accordion">
            <summary class="ax-mobile-states-summary">
              <span>Alle 16 Bundesländer anwählen</span>
              <span class="ax-accordion-icon">▾</span>
            </summary>
            <div class="ax-mobile-states-grid">
              {bundeslaender.map((land) => (
                <a href={`/solaratlas/${land.slug}`} class="ax-mobile-state-pill">
                  <span>{land.name}</span>
                  <span class="ax-mobile-state-pill__score">{land.solarmetrikScore}</span>
                </a>
              ))}
            </div>
          </details>
        </div>

        <!-- Group 2: Rechner & Tools -->
        <div class="ax-mobile-nav__group">
          <div class="ax-mobile-nav__heading">Rechner & Ingenieur-Tools</div>
          <a href="/rechner" class:list={['ax-mobile-nav__link', { active: activeSection === 'rechner' }]}>
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">PV-Rendite- & Dachrechner</span>
              <span class="ax-mobile-nav__secondary">360°-Ertragssimulation & Amortisation</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>

          <a href="/speicher-rechner" class="ax-mobile-nav__link">
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">Stromspeicher-Rechner</span>
              <span class="ax-mobile-nav__secondary">Autarkiegrad & HTW-Inspektionsbenchmark</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>

          <a href="/foerderung-check" class="ax-mobile-nav__link">
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">Förderung 2026 & PLZ-Check</span>
              <span class="ax-mobile-nav__secondary">KfW 270, Solarpflicht & Stadtwerke</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>
        </div>

        <!-- Group 3: Wissen & Methodik -->
        <div class="ax-mobile-nav__group">
          <div class="ax-mobile-nav__heading">Wissen & Methodik</div>
          <a href="/ratgeber" class:list={['ax-mobile-nav__link', { active: activeSection === 'ratgeber' }]}>
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">Ratgeber & EEG 2027</span>
              <span class="ax-mobile-nav__secondary">Preise, 0 % MwSt., § 51 EEG & Smart Meter</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>

          <a href="/methodik" class:list={['ax-mobile-nav__link', { active: activeSection === 'methodik' }]}>
            <div class="ax-mobile-nav__text">
              <span class="ax-mobile-nav__primary">Methodik (SME-2026 Index)</span>
              <span class="ax-mobile-nav__secondary">Formeln & DWD-1×1-km-Globalstrahlung</span>
            </div>
            <span class="ax-mobile-nav__arrow">→</span>
          </a>
        </div>

        <!-- Group 4: Meta & E-E-A-T Links -->
        <div class="ax-mobile-nav__meta">
          <div class="ax-mobile-nav__meta-links">
            <a href="/ueber-uns">Über uns & Redaktion</a>
            <span>·</span>
            <a href="https://doi.org/10.5281/zenodo.23956818" target="_blank" rel="noopener">Zenodo Open Data ↗</a>
            <span>·</span>
            <a href="/impressum">Impressum</a>
            <span>·</span>
            <a href="/datenschutz">Datenschutz</a>
          </div>
          <p class="ax-mobile-nav__meta-copy">
            SOLARMETRIK — Deutsches Photovoltaik-Dateninstitut<br />
            Datenbasis: Bundesnetzagentur (MaStR) & DWD (11/2026)
          </p>
        </div>
      </nav>
    </div>
  </div>
</header>

<script is:inline define:vars={{ allStaedteSearch }}>
  (() => {
    function navigateMatch(val) {
      const q = (val || '').trim().toLowerCase();
      if (!q) return;
      const match = allStaedteSearch.find(
        (s) =>
          s.name.toLowerCase() === q ||
          s.name.toLowerCase().startsWith(q) ||
          s.plz.toLowerCase().includes(q)
      );
      if (match) {
        window.location.href = match.url;
      } else {
        window.location.href = `/foerderung-check?q=${encodeURIComponent(val.trim())}`;
      }
    }

    // Desktop Search
    const deskInput = document.getElementById('header-city-search-input');
    const deskForm = document.getElementById('header-city-search-form');
    if (deskInput && deskForm) {
      deskInput.addEventListener('change', (e) => navigateMatch(e.target.value));
      deskForm.addEventListener('submit', (e) => {
        e.preventDefault();
        navigateMatch(deskInput.value);
      });
    }

    // Mobile Search
    const mobInput = document.getElementById('mobile-city-search-input');
    const mobForm = document.getElementById('mobile-city-search-form');
    if (mobInput && mobForm) {
      mobInput.addEventListener('change', (e) => navigateMatch(e.target.value));
      mobForm.addEventListener('submit', (e) => {
        e.preventDefault();
        navigateMatch(mobInput.value);
      });
    }

    // Mobile Toggle & Drawer
    const header = document.getElementById('ax-site-header');
    const toggleBtn = document.getElementById('ax-mobile-toggle');
    const drawer = document.getElementById('ax-mobile-drawer');

    if (toggleBtn && drawer && header) {
      function setMenuState(open) {
        if (open) {
          header.classList.add('has-mobile-open');
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          toggleBtn.setAttribute('aria-expanded', 'true');
          toggleBtn.setAttribute('aria-label', 'Menü schließen');
          document.body.classList.add('nav-locked');
        } else {
          header.classList.remove('has-mobile-open');
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          toggleBtn.setAttribute('aria-expanded', 'false');
          toggleBtn.setAttribute('aria-label', 'Menü öffnen');
          document.body.classList.remove('nav-locked');
        }
      }

      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = drawer.classList.contains('is-open');
        setMenuState(!isOpen);
      });

      // Close menu on link click inside drawer
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setMenuState(false);
        });
      });

      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          setMenuState(false);
        }
      });
    }
  })();
</script>
